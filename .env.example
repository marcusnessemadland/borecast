# Required by MET Norway. Use a real project URL or contact address.
MET_USER_AGENT="BoreCast/0.1 https://github.com/your-user/borecast contact@example.com"

# Use deterministic, clearly labelled sample data without calling providers.
BORECAST_DEMO_MODE="false"

# Optional future Web Push infrastructure. Alert rules work locally without these.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
